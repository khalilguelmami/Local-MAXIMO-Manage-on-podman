# Copy this file to manage-dev.env and fill in your values.
# manage-dev.env is listed in .gitignore: never commit it.

# --- Database (SQL Server reachable from the Podman VM) ---
MXE_DB_NAME=MAXDB90
MXE_DB_PORT=1433
MXE_DB_USER=maximo
MXE_DB_PASSWORD=change-me

# --- Maximo crypto keys ---
# Must be the keys of the environment your database backup comes from,
# otherwise encrypted values (passwords, endpoints) will not decrypt.
MXE_SECURITY_CRYPTO_KEY=
MXE_SECURITY_OLD_CRYPTO_KEY=
MXE_SECURITY_CRYPTOX_KEY=
MXE_SECURITY_OLD_CRYPTOX_KEY=
